<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup>
    <EsapiReferenceDir Condition="Exists('C:\Users\etav0001\Downloads\CollisionAvoidance-First-branch\CollisionAvoidance-First-branch\Esapi18\VMS.TPS.Common.Model.API.dll')">C:\Users\etav0001\Downloads\CollisionAvoidance-First-branch\CollisionAvoidance-First-branch\Esapi18</EsapiReferenceDir>
    <EsapiReferenceDir Condition="'$(EsapiReferenceDir)' == '' and Exists('C:\Program Files (x86)\Varian\RTM\18.1\esapi\API\VMS.TPS.Common.Model.API.dll')">C:\Program Files (x86)\Varian\RTM\18.1\esapi\API</EsapiReferenceDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="paket.references" />
    <Compile Include="EsapiGeometryMapping.fs" />
    <Compile Include="EsapiPlanExtraction.fs" />
    <Compile Include="ContextValidation.fs" />
    <Compile Include="PatientIdObfuscation.fs" />
    <Compile Include="SafeServerClient.fs" />
    <Compile Include="ExportWorkflow.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="VMS.TPS.Common.Model.API">
      <HintPath>$(EsapiReferenceDir)\VMS.TPS.Common.Model.API.dll</HintPath>
    </Reference>
    <Reference Include="VMS.TPS.Common.Model.Types">
      <HintPath>$(EsapiReferenceDir)\VMS.TPS.Common.Model.Types.dll</HintPath>
    </Reference>
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src-contracts\CollisionAvoidance.Contracts\CollisionAvoidance.Contracts.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
